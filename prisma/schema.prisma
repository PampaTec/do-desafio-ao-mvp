generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String   @id @default(uuid())
  googleId  String?  @unique @map("google_id")
  email     String   @unique
  name      String?
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  teamsOwned     Team[]        @relation("TeamOwner")
  teamMembers    TeamMember[]
  skillVersions  SkillVersion[]
  skillAuditLogs SkillAuditLog[]

  @@map("profiles")
}

model Team {
  id           String   @id @default(uuid())
  projectName  String   @map("project_name")
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  currentStage Int      @default(1) @map("current_stage")
  status       String   @default("active")

  owner       Profile?      @relation("TeamOwner", fields: [createdBy], references: [id])
  members     TeamMember[]
  chatMessages ChatMessage[]
  progress    TeamProgress[]

  @@map("teams")
}

model TeamMember {
  id           String   @id @default(uuid())
  teamId       String   @map("team_id")
  userId       String?  @map("user_id")
  invitedEmail String?  @map("invited_email")
  joinedAt     DateTime @default(now()) @map("joined_at")

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [userId], references: [id])

  @@map("team_members")
}

model ChatMessage {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  role      String
  content   String
  stage     Int?
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model TeamProgress {
  id          String    @id @default(uuid())
  teamId      String    @map("team_id")
  stage       Int
  status      String    @default("pending")
  stageOutput String?   @map("stage_output")
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_progress")
}

model SkillVersion {
  id          String   @id @default(uuid())
  versionLabel String  @map("version_label")
  contentMd   String   @map("content_md")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  isActive    Boolean  @default(false) @map("is_active")

  creator Profile? @relation(fields: [createdBy], references: [id])

  @@map("skill_versions")
}

model SkillAuditLog {
  id           String   @id @default(uuid())
  adminId      String?  @map("admin_id")
  action       String
  fieldsChanged Json? @map("fields_changed")
  createdAt    DateTime @default(now()) @map("created_at")

  admin Profile? @relation(fields: [adminId], references: [id])

  @@map("skill_audit_log")
}
